# Cloud-Reaper Configuration
APP_ENV=development

# Web Dashboard Settings
# Port 5001 is used to avoid conflict with macOS AirPlay Receiver on port 5000
FLASK_PORT=5001
FLASK_HOST=127.0.0.1
FLASK_DEBUG=True

# Azure Credentials
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

# Database (SQLite by default, PostgreSQL optional)
DATABASE_URL=sqlite:///./data/reaper.db
# For PostgreSQL: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Database Connection Pool Settings (Go engine)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=5

# Prometheus Integration (Optional)
# Set DATA_PUSHER_BACKEND=prometheus to enable Prometheus integration
DATA_PUSHER_BACKEND=local
PROMETHEUS_PUSHGATEWAY_URL=localhost:9091
PROMETHEUS_JOB_NAME=cloud-reaper

# AI / GenAI Keys (required for Copilot, AI Architect, and GenAI Triage features)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# AI Backend Selection
# Options: gemini, openai, ensemble
# - gemini: Use Google Gemini (default, requires GEMINI_API_KEY)
# - openai: Use OpenAI (requires OPENAI_API_KEY)
# - ensemble: Use all available backends and combine results
AI_BACKEND=gemini

# AI/ML Features Configuration
# Enable/disable AI/ML features (set to false if API keys are not available)
AI_ML_ENABLED=true
GOVERNANCE_ENABLED=true

# ==============================================================================
# SECURITY & REMEDIATION SETTINGS
# ==============================================================================
# DRY-RUN MODE (DEFAULT: true for safety)
# When true, Cloud-Reaper will only report recommendations without executing changes
# This is the "Blast Radius Paranoia" security default - read-only operation
DRY_RUN_MODE=true

# ENABLE ACTIVE REMEDIATION (DEFAULT: false for safety)
# When false, remediation actions are disabled and only recommendations are shown
# When true, Cloud-Reaper can execute cost optimization actions (stop VMs, resize, etc.)
# WARNING: This requires write-access IAM permissions and should only be enabled
# after reviewing recommendations in dry-run mode
ENABLE_REMEDIATION=false

# ORCHESTRATION MODE (DEFAULT: false for safety)
# When enabled, allows automated execution of optimization schedules
# Requires separate IAM role with specific write permissions (see documentation)
ENABLE_ORCHESTRATION=false

# ==============================================================================
# Enhanced Anomaly Explainer
# ==============================================================================
# Optional: Redis URL for caching anomaly patterns
# Format: redis://[password@]localhost:6379/0
# If not provided, caching will be disabled
REDIS_URL=redis://localhost:6379/0

# Optional: Redis password (if using Redis with authentication)
# REDIS_PASSWORD=your_redis_password

# Optional: Cache TTL in seconds (default: 86400 = 24 hours)
ANOMALY_CACHE_TTL=86400

# Optional: Enable/disable specific features
ENABLE_SHAP_ANALYSIS=true
ENABLE_TIME_SERIES_DECOMPOSITION=true
ENABLE_ANOMALY_CLUSTERING=true
ENABLE_RULE_BASED_FALLBACK=true

# Optional: Clustering parameters
CLUSTERING_MIN_SAMPLES=5
CLUSTERING_EPS=0.5
CLUSTERING_N_CLUSTERS=5

# Optional: Time-series decomposition parameters
DECOMPOSITION_PERIOD=7  # Weekly seasonality
DECOMPOSITION_MODEL=additive  # or 'multiplicative'

# Optional: SHAP analysis parameters
SHAP_SYNTHETIC_SAMPLES=50
SHAP_TOP_FEATURES=5

# ==============================================================================
# Enhanced RAG Search Engine
# ==============================================================================
# === Learnable Ranking ===
RANKING_MODEL=xgboost  # Options: xgboost, lightgbm, sklearn
MIN_TRAINING_SAMPLES=100
RETRAIN_INTERVAL=86400  # Retrain every 24 hours

# === DPP Diversification ===
DPP_LAMBDA=0.7  # Trade-off between relevance (0) and diversity (1)
ENABLE_MMR_FALLBACK=true
MMR_LAMBDA=0.5

# === Local Semantic Search ===
LOCAL_MODEL=all-MiniLM-L6-v2  # Options: all-MiniLM-L6-v2, all-mpnet-base-v2, paraphrase-MiniLM-L6-v2
ENABLE_API_FALLBACK=true
FAISS_INDEX_TYPE=IndexFlatL2

# === Faceted Search ===
AUTO_EXTRACT_FACETS=true
FACET_TYPES=file_type,date,file_name
MAX_FACET_VALUES=20

# === Query Optimization ===
ENABLE_QUERY_REWRITING=true
ENABLE_QUERY_CACHING=true
QUERY_CACHE_TTL=3600
MAX_VARIATIONS=10

# === Result Caching ===
# REDIS_URL=redis://localhost:6379/0 (Same as above)
CACHE_TTL=3600
LOCAL_CACHE_SIZE=1000
ENABLE_CACHE_STATS=true

# === A/B Testing ===
ENABLE_AB_TESTING=false
DEFAULT_TRAFFIC_SPLIT=equal
SIGNIFICANCE_THRESHOLD=0.05
MIN_SAMPLE_SIZE=100

# === Personalization ===
ENABLE_PERSONALIZATION=true
ACTION_TYPES=click,dwell,bookmark,share
PROFILE_UPDATE_INTERVAL=3600
MIN_ACTIONS_FOR_PERSONALIZATION=5

# === Feature Flags ===
ENABLE_LEARNABLE_RANKING=true
ENABLE_DPP_DIVERSIFICATION=true
ENABLE_LOCAL_SEMANTIC=true
ENABLE_FACETED_SEARCH=true
ENABLE_QUERY_OPTIMIZATION=true
ENABLE_RESULT_CACHING=true
ENABLE_PERSONALIZATION=true
