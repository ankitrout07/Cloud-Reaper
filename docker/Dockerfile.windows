# ==============================================================================
# Cross-Compilation Dockerfile for Windows (MinGW-w64)
# Produces Cloud-Reaper Windows 64-bit binaries
# ==============================================================================

FROM golang:1.24-bookworm AS builder

RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc-mingw-w64 \
    g++-mingw-w64 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY src/engine-go/go.mod src/engine-go/go.sum ./
RUN go mod download

COPY src/engine-go/ .

ENV CGO_ENABLED=1 \
    GOOS=windows \
    GOARCH=amd64 \
    CC=x86_64-w64-mingw32-gcc \
    CXX=x86_64-w64-mingw32-g++

RUN mkdir -p /output && \
    go build -tags=cli -ldflags="-w -s" -o /output/reaper-engine.exe . && \
    go build -ldflags="-w -s" -o /output/taskserver.exe ./cmd/taskserver && \
    go build -ldflags="-w -s" -o /output/websocketserver.exe ./cmd/websocketserver && \
    go build -ldflags="-w -s" -o /output/ratelimitserver.exe ./cmd/ratelimitserver && \
    go build -ldflags="-w -s" -o /output/ragserver.exe ./cmd/ragserver && \
    go build -ldflags="-w -s" -o /output/calculatorserver.exe ./cmd/calculatorserver && \
    go build -ldflags="-w -s" -o /output/anomalyserver.exe ./cmd/anomalyserver

FROM alpine:3.20
WORKDIR /dist
COPY --from=builder /output/* ./
CMD ["ls", "-la", "/dist"]
